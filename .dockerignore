# Git history
.git/

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.env

# Large user-provided data — bind-mounted at runtime, not baked into the image.
# Place these in the local directories; they will be visible to the container.
checkpoints/m2a/*.ckpt
checkpoints/m2a/*.pt
checkpoints/tnp/*.pt
checkpoints/tnp/*.ckpt
references/*.wav
references/*.flac
references/*.mp3
soundfonts/*.sf2

# Run outputs / local input audio
output/
input/

# Audio (never part of the image)
*.wav
*.mp3
*.flac
*.ogg
*.aiff

# Local tooling
.agents/
skills-lock.json
refactoring_plan.md

# Diagnostic outputs / notebooks
scripts/__pycache__/
